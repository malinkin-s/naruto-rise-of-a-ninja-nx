# Game data: never commit anything from the disc, DLC or title update (copyrighted)
game/
game_root/
*.iso
*.xex
*.dll
*.bik
*.big
*.fat
*.sdb
*.xzp
*.SRA
*.bf
*.stfs
dlc/
title_update/

# Generated from the game: recompiled code, shader dumps and packages
generated/
app/generated/
out/
build/
build-*/
*.nro
*.nacp
*.dksh
*.bdkg

# Reference checkouts kept next to the port
ref/

# Editors
.vscode/
.idea/
# --- SDK third-party sources: tools/fetch_thirdparty.py fetches them; only the files this port changed are tracked --
/sdk/thirdparty/*
!/sdk/thirdparty/CMakeLists.txt
!/sdk/thirdparty/FFmpeg
/sdk/thirdparty/FFmpeg/*
!/sdk/thirdparty/FFmpeg/config.h
!/sdk/thirdparty/FFmpeg/config_switch_aarch64.h
!/sdk/thirdparty/FFmpeg/config_masseffect_wmv3.h
!/sdk/thirdparty/FFmpeg/libavcodec
/sdk/thirdparty/FFmpeg/libavcodec/*
!/sdk/thirdparty/FFmpeg/libavcodec/mdct_template.c
!/sdk/thirdparty/FFmpeg/libavcodec/fft_template.c
!/sdk/thirdparty/ffmpeg-overlay
/sdk/thirdparty/ffmpeg-overlay/*
!/sdk/thirdparty/ffmpeg-overlay/codec_list.c

# Logs
*.log
/cache/
__pycache__/
tools/switch/nx.env

# Renderer third-party trees (tools/fetch_renut_deps.sh)
/app/thirdparty/

# Packages made by the installer page (game shaders)
installer test/
naruto-nx_*/
